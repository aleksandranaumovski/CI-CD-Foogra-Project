# Dependencies
/backend/vendor
/frontend/node_modules

# Build output
/frontend/dist
/backend/public/build
/backend/public/hot

# Local environment — .env.example is committed, .env is not
/backend/.env
/backend/.env.backup

# Laravel runtime
/backend/storage/*.key
/backend/storage/app/public/*
!/backend/storage/app/public/.gitignore
/backend/storage/framework/cache/data/*
/backend/storage/framework/sessions/*
/backend/storage/framework/views/*
/backend/storage/logs/*.log
/backend/bootstrap/cache/*.php
/backend/public/storage
/backend/.phpunit.result.cache

# Generated API specification — regenerate with `php artisan scramble:export`
/backend/api.json

# The Foogra template assets are copied in by frontend/copy-assets.sh rather
# than committed, since they belong to the purchased ThemeForest licence.
/frontend/public/css
/frontend/public/img
/frontend/public/video
/frontend/placeholder-backup

# Python bytecode from the helper scripts
__pycache__/
*.pyc

# Editors and OS
.DS_Store
Thumbs.db
.idea
.vscode
*.swp
