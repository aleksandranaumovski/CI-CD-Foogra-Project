APP_NAME=Foogra
APP_ENV=local
APP_KEY=base64:SaaZHqU6UkY5pIzxdCobiF5q+8qAHjG3Uw45rf4xUaY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# Where the React app lives — used for CORS, Sanctum and password-reset links.
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3310
DB_DATABASE=foogra
DB_USERNAME=foogra
DB_PASSWORD=secret

# Second container (docker-compose service `mysql_test`) used by `php artisan test`.
DB_TEST_HOST=127.0.0.1
DB_TEST_PORT=3308
DB_TEST_DATABASE=foogra_test
DB_TEST_USERNAME=foogra
DB_TEST_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

# Mailpit — open http://localhost:8025 to read password-reset / booking mails.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@foogra.test"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8000

VITE_APP_NAME="${APP_NAME}"
