# Rendered by the official nginx image's docker-entrypoint (envsubst on
# every *.template under /etc/nginx/templates/) — ${API_HOST}/${API_PORT}
# come from environment variables, so the same built image works unchanged
# under Compose (API_HOST=api) and Kubernetes (API_HOST=api.<namespace>.svc
# or just "api" inside the same namespace).
upstream foogra_api {
    server ${API_HOST}:${API_PORT};
    keepalive 16;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    charset utf-8;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # Everything Laravel owns — proxied server-side, so the browser only
    # ever talks to this single origin (no CORS preflight, no cross-site
    # cookie juggling for Sanctum).
    location ~ ^/(api|sanctum|docs|storage)/ {
        proxy_pass http://foogra_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /up {
        proxy_pass http://foogra_api;
    }

    # Vite fingerprints everything under /assets, so it is safe to cache hard.
    location ^~ /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location ~* \.(?:css|js|jpg|jpeg|png|gif|webp|svg|ico|woff2?|ttf|eot|mp4|webm)$ {
        expires 7d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }

    # SPA history fallback: any other GET is a client-side route, hand back
    # index.html and let React Router resolve it.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
